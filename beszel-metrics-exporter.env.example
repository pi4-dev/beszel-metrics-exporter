BESZEL_URL=http://beszel:8090

# Recommended: dedicated Beszel account with readonly role and access to the
# systems that should be exported (or BESZEL_HUB_SHARE_ALL_SYSTEMS=true on Hub).
BESZEL_USER=monitoring@example.invalid
BESZEL_PASSWORD=change-me

# Alternative to username/password. Leave empty when using password auth.
BESZEL_TOKEN=

REQUEST_TIMEOUT=10
# Total wall-clock budget for one scrape, including auth, pagination and lock waiting.
# Keep below vmagent scrape_timeout (20s in the supplied example).
SCRAPE_BUDGET_SECONDS=15
CACHE_TTL=15
FAILURE_CACHE_TTL=5
MAX_STATS_AGE_SECONDS=180
MAX_MONITOR_STATS_AGE_SECONDS=600
BULK_PAGE_SIZE=500
BULK_MAX_PAGES=5
LEGACY_UNITS=false
LOG_LEVEL=INFO
