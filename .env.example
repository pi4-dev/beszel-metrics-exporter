# Beszel Hub URL as seen from the exporter container.
BESZEL_URL=http://beszel:8090

# Recommended: create a dedicated read-only Beszel user.
BESZEL_USER=monitoring@example.invalid
BESZEL_PASSWORD=change-me

# Alternative to username/password. Leave empty when using password authentication.
# Static tokens can expire depending on the Beszel/PocketBase configuration.
BESZEL_TOKEN=

REQUEST_TIMEOUT=10
CACHE_TTL=15
EXPORTER_PORT=9105
